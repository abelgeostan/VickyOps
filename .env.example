# VickyOps Environment Configuration Template
# Copy this file to .env and replace placeholder values with your real configuration.

# Server & Ports
PORT=3050
ENVIRONMENT=production

# Database Credentials
POSTGRES_DB=vickyops
POSTGRES_USER=vickyops
POSTGRES_PASSWORD=your_secure_db_password_here
DATABASE_URL=postgresql+asyncpg://vickyops:your_secure_db_password_here@db:5432/vickyops

# Security & Authentication (Generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change_this_to_a_long_random_secret_in_production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_admin_password

# External Ollama AI Server
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:latest

# Remote Ubuntu Server SSH Target
SSH_HOST=192.168.1.123
SSH_PORT=22
SSH_USER=your_ssh_username
SSH_PASSWORD=your_ssh_password
SSH_KEY_PATH=~/.ssh/id_ed25519
SSH_TIMEOUT=15

# Security Controls
ENABLE_REAL_SSH=true
AUTO_APPROVE_SAFE=true
REQUIRE_APPROVAL_DESTRUCTIVE=true
